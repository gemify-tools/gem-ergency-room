# Example systemd unit. Install with pipx/pip first (e.g. `pipx install .`), then:
#   sudo cp deploy/gem-ergency-room.service /etc/systemd/system/ && sudo systemctl enable --now gem-ergency-room
# Adjust ExecStart to the path printed by `which gem-ergency-room`.
[Unit]
Description=The Gem-ergency Room task board
After=network.target

[Service]
DynamicUser=yes
StateDirectory=gem-ergency-room
Environment=GEM_DB_PATH=/var/lib/gem-ergency-room/tasks.db
Environment=GEM_HOST=127.0.0.1
Environment=GEM_PORT=8000
# Environment=GEM_MAX_HIGH=3
# Environment=GEM_MAX_MEDIUM=5
# Environment=GEM_MAX_LOW=unlimited
ExecStart=/usr/local/bin/gem-ergency-room
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
